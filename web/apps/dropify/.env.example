# Whop API (server-side only)
# Get your API key from https://whop.com/developer
WHOP_API_KEY=sk_live_xxxxx

# Whop webhook signing secret (server-side only)
# Create this in the Whop dashboard for /api/webhooks/whop
WHOP_WEBHOOK_SECRET=ws_xxxxx

# Whop App (public)
# Find these in your app settings at https://whop.com/developer
NEXT_PUBLIC_WHOP_APP_ID=app_xxxxx
NEXT_PUBLIC_WHOP_COMPANY_ID=biz_xxxxx
# Optional: leave blank on Vercel Preview so the app uses the request origin.
NEXT_PUBLIC_APP_URL=http://localhost:5007

# Whop Environment: "sandbox" for testing, "production" for live payments
NEXT_PUBLIC_WHOP_ENVIRONMENT=sandbox

# NextAuth
AUTH_SECRET=xxxxx

# Whop OAuth
WHOP_CLIENT_SECRET=xxxxx
