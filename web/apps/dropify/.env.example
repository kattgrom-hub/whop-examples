# Set both server and Elements to the same environment. Preview must be sandbox.
NEXT_PUBLIC_WHOP_ENVIRONMENT=sandbox
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
NEXT_PUBLIC_WHOP_COMPANY_ID=
NEXT_PUBLIC_WHOP_APP_ID=
# HTTPS origin in production. Leave blank for Preview and set CHECKOUT_ALLOWED_ORIGINS,
# or let the platform VERCEL_URL supply the allowlisted preview origin.
NEXT_PUBLIC_APP_URL=http://localhost:5007
CHECKOUT_ALLOWED_ORIGINS=
# Generate at least 32 random characters; server-only, never paste in chat.
CHECKOUT_SIGNING_SECRET=
# Dedicated order database; apply database/orders.sql first. Server-only.
DROPIFY_SUPABASE_URL=
DROPIFY_SUPABASE_SERVICE_ROLE_KEY=
# Existing optional Whop OAuth settings
AUTH_SECRET=
WHOP_CLIENT_SECRET=

# Comma-separated authenticated Whop user IDs allowed to access /fulfilment
DROPIFY_FULFILMENT_ADMIN_IDS=
