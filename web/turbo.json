{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_WHOP_APP_ID",
        "NEXT_PUBLIC_WHOP_COMPANY_ID",
        "NEXT_PUBLIC_APP_URL",
        "WHOP_API_KEY",
        "WHOP_CLIENT_SECRET",
        "AUTH_SECRET",
        "AUTH_TRUST_HOST",
        "ENABLE_COREPACK",
        "ENABLE_EXPERIMENTAL_COREPACK",
        "BLOB_READ_WRITE_TOKEN",
        "NEXT_PUBLIC_WHOP_CHAT_CHANNEL_ID",
        "NEXT_PUBLIC_WHOP_ENVIRONMENT"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
