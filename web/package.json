{
  "name": "whop-examples",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "turbo build",
    "dev": "echo 'Use: pnpm dev:<app> (or cd into apps/[app] and run pnpm dev)'",
    "dev:masterclass": "turbo dev --filter=masterclass",
    "dev:waterbnb": "turbo dev --filter=waterbnb",
    "dev:dischord": "turbo dev --filter=dischord",
    "dev:sockx": "turbo dev --filter=sockx",
    "dev:dropify": "turbo dev --filter=dropify",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  }
}
